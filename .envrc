# Sessions and shells started in this repository run the Rust taskloom that
# `just install` builds, not the Go taskloom on PATH: ctxloom resolves its
# companions, and the engine its MCP servers, by bare name on the PATH it is
# started with. Every other project keeps the Go binary. Enable once per
# checkout (worktrees too): direnv allow
root="${TASKLOOM_RS_ROOT:-$HOME/.local/share/taskloom-rs}"
if [ -x "$root/bin/taskloom" ]; then
  PATH_add "$root/bin"
else
  log_error "no Rust taskloom at $root/bin/taskloom: run \`just install\`; until then this shell runs the Go taskloom, whose tasks the Rust store never sees"
fi
