plans-cli-output = cannot write the output: { $ext_err_txt }
plans-cli-unknown-status = { $status } is not a plan status: draft, active, superseded, done or abandoned
plans-cli-no-link = plan { $command } needs --governs <task> (one or more) or --supersedes <plan>
plans-cli-file-missing = plan { $plan }'s file is missing: { $path }
